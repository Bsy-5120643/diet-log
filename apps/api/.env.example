# Neon pooled 连接串（务必带 -pooler 主机名与 sslmode=require）
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Vercel 前端域名
CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# ---- AI 拍照识别 ----
# 阿里云通义千问 API Key。从 https://dashscope.console.aliyun.com/apiKey 获取。
# 注意：只在本文件（.env）里配置，.env 不得提交到版本库；代码里也不要硬编码。
# 留空则 AI 识别接口返回配置错误，不影响其它功能。
DASHSCOPE_API_KEY=

# 视觉模型名与超时（秒）。超时按 SPEC 定为 15s，防止模型卡死拖垮服务。
AI_VISION_MODEL=qwen-vl-max-latest
AI_VISION_TIMEOUT_SECONDS=15

# 单张图片体积上限（字节），默认 8MB
AI_VISION_MAX_IMAGE_BYTES=8388608
